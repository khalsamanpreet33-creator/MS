{
  "name": "school-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "npm-run-all -p dev:server dev:web",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace server run build && npm --workspace web run build",
    "start": "npm --workspace server run start",
    "migrate": "npm --workspace server run migrate",
    "seed": "npm --workspace server run seed",
    "backup:now": "npm --workspace server run backup:now",
    "tauri": "cargo --manifest-path src-tauri/Cargo.toml tauri",
    "tauri:dev": "cargo --manifest-path src-tauri/Cargo.toml tauri dev",
    "tauri:build": "cargo --manifest-path src-tauri/Cargo.toml tauri build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}