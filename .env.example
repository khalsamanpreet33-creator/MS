# Server
PORT=4000
HOST=0.0.0.0

# Auth
JWT_SECRET=dev-secret-change-me-in-production
JWT_TTL=43200

# Database
DB_PATH=./server/data/school.db

# Storage
SCHOOL_DATA_DIR=./school-data
BACKUPS_DIR=./backups
BACKUP_RETENTION=14

# Background jobs
OUTBOX_FLUSH_MS=30000

# System events retention (days). Older rows are pruned nightly at 03:00.
SYSTEM_EVENTS_RETENTION_DAYS=90

# CORS — origin of the web client (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000

# Upload size limit (bytes)
UPLOAD_MAX_BYTES=10485760